
; GX Works2 梯形图程序 - FX3U交通信号灯控制系统
; 型号: FX3U
; 输入: X0=启动, X1=急停
; 输出: Y0=南北红, Y1=南北黄, Y2=南北绿, Y3=东西红, Y4=东西黄, Y5=东西绿
; 时间参数: 南北绿40s, 南北黄5s, 东西绿40s, 东西黄5s

;========================================
; 程序步骤:
; 1. 初始化 - 所有灯灭
; 2. 启动检测 - 检查X0启动和X1急停
; 3. 定时器控制 - 通过计数器计时
; 4. 状态转移 - 循环切换交通灯状态
;========================================

ORG 0

;========== 标签定义 ==========
LABEL START_LABEL

;========== 第0段: 初始化和启动控制 ==========
; 紧急停止 - X1按下时所有灯灭
X1 KOUT K0 Y0 Y5    ; 紧急停止时，清除Y0-Y5所有输出
BRK

; 启动条件检查
X0 
AND NOT M0          ; X0按下且M0未设置时进入
SET M0              ; 设置启动标志M0
SET M1              ; 设置运行标志M1

;========== 第1段: 南北绿灯亮 (40秒) ==========
; 检查是否在南北绿状态
M1 AND NOT M2 AND NOT M3
SET Y2              ; Y2=南北绿亮
RST Y0              ; Y0=南北红灭
RST Y1              ; Y1=南北黄灭
RST Y3              ; Y3=东西红灭
RST Y4              ; Y4=东西黄灭
RST Y5              ; Y5=东西绿灭

; 40秒定时器 - 使用计数器C0
AND NOT C0
DCNT K40 C0         ; C0计数40秒
BRK

; 40秒到时,转入南北黄灯状态
C0 GE K40
RST C0              ; 清除计数器
SET M2              ; 设置南北黄灯标志
RST M3              ; 清除东西绿灯标志

;========== 第2段: 南北黄灯亮 (5秒) ==========
; 检查是否在南北黄状态
M1 AND M2 AND NOT M3
SET Y1              ; Y1=南北黄亮
RST Y0              ; Y0=南北红灭
RST Y2              ; Y2=南北绿灭
RST Y3              ; Y3=东西红灭
RST Y4              ; Y4=东西黄灭
RST Y5              ; Y5=东西绿灭

; 5秒定时器 - 使用计数器C1
AND NOT C1
DCNT K5 C1          ; C1计数5秒
BRK

; 5秒到时,转入东西绿灯状态
C1 GE K5
RST C1              ; 清除计数器
RST M2              ; 清除南北黄灯标志
SET M3              ; 设置东西绿灯标志

;========== 第3段: 东西绿灯亮 (40秒) ==========
; 检查是否在东西绿状态
M1 AND M3 AND NOT M4
SET Y5              ; Y5=东西绿亮
RST Y0              ; Y0=南北红灭
RST Y1              ; Y1=南北黄灭
RST Y2              ; Y2=南北绿灭
RST Y3              ; Y3=东西红灭
RST Y4              ; Y4=东西黄灭

; 40秒定时器 - 使用计数器C2
AND NOT C2
DCNT K40 C2         ; C2计数40秒
BRK

; 40秒到时,转入东西黄灯状态
C2 GE K40
RST C2              ; 清除计数器
SET M4              ; 设置东西黄灯标志

;========== 第4段: 东西黄灯亮 (5秒) ==========
; 检查是否在东西黄状态
M1 AND M4
SET Y4              ; Y4=东西黄亮
RST Y0              ; Y0=南北红灭
RST Y1              ; Y1=南北黄灭
RST Y2              ; Y2=南北绿灭
RST Y3              ; Y3=东西红灭
RST Y5              ; Y5=东西绿灭

; 5秒定时器 - 使用计数器C3
AND NOT C3
DCNT K5 C3          ; C3计数5秒
BRK

; 5秒到时,循环回到南北绿灯状态
C3 GE K5
RST C3              ; 清除计数器
RST M2              ; 清除南北黄灯标志
RST M3              ; 清除东西绿灯标志
RST M4              ; 清除东西黄灯标志

;========== 第5段: 停止控制 ==========
; X0未按下时停止运行
NOT X0
RST M0              ; 清除启动标志
RST M1              ; 清除运行标志
RST M2
RST M3
RST M4
RST C0
RST C1
RST C2
RST C3
RST Y0              ; 所有输出清零
RST Y1
RST Y2
RST Y3
RST Y4
RST Y5

END

;========================================
; 变量定义表
;========================================
; 输入 (Input):
; X0 - 启动按钮
; X1 - 急停按钮
;
; 输出 (Output):
; Y0 - 南北红灯
; Y1 - 南北黄灯
; Y2 - 南北绿灯
; Y3 - 东西红灯
; Y4 - 东西黄灯
; Y5 - 东西绿灯
;
; 内部标志 (Internal Relay):
; M0 - 启动标志
; M1 - 运行标志
; M2 - 南北黄灯状态标志
; M3 - 东西绿灯状态标志
; M4 - 东西黄灯状态标志
;
; 计数器 (Counter):
; C0 - 南北绿灯计时器 (40秒)
; C1 - 南北黄灯计时器 (5秒)
; C2 - 东西绿灯计时器 (40秒)
; C3 - 东西黄灯计时器 (5秒)

;========================================
; 工作流程说明
;========================================
; 1. 按下X0启动按钮 → 进入自动循环模式
; 2. 南北绿灯亮40秒 → 南北黄灯亮5秒
; 3. 东西绿灯亮40秒 → 东西黄灯亮5秒
; 4. 循环重复以上过程
; 5. 按下X1急停按钮 → 所有灯灭，程序停止
; 6. 释放X0启动按钮 → 程序停止，灯灭

;========================================
