#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$ROOT/GXWorks-Agent-MCP" ]; then
  exec "$ROOT/GXWorks-Agent-MCP" "$@"
fi
if [ -x "$ROOT/.venv-mcp/bin/python" ]; then
  exec "$ROOT/.venv-mcp/bin/python" "$ROOT/scripts/mcp_entry.py" "$@"
fi
if [ -x "$ROOT/.venv/bin/python" ]; then
  exec "$ROOT/.venv/bin/python" "$ROOT/scripts/mcp_entry.py" "$@"
fi
exec python3 "$ROOT/scripts/mcp_entry.py" "$@"
